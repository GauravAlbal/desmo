{
  "schema": "ikaros.permission-routing.v1",
  "classes": {
    "read": "Inspect files or an existing store. Must not change store bytes.",
    "scratch": "Create files only under a fresh directory this command names. Never open an existing store. ik scenario has no --store flag.",
    "write-source": "Edit project source, machine files, scenarios, generated bindings, and docs.",
    "write-store": "Submit a lifecycle mutation or effect outcome against an existing store."
  },
  "modes": {
    "investigate_only": {
      "allowed": ["read", "scratch"],
      "note": "Inspect-only never writes source and never writes a store. ik analysis run is not in this mode.",
      "operations": [
        {"id": "doctor", "class": "read", "bin": "desmo", "argv": ["doctor", "--dir", "{project}", "--json"], "touches_store": false},
        {"id": "identity", "class": "read", "bin": "ik", "argv": ["identity", "{machine}"], "touches_store": false},
        {"id": "laws", "class": "read", "bin": "ik", "argv": ["laws", "{machine}"], "touches_store": false},
        {"id": "schema", "class": "read", "bin": "ik", "argv": ["schema", "{machine}"], "touches_store": false},
        {"id": "check-plan", "class": "read", "bin": "ik", "argv": ["check", "{machine}", "--profile", "{profile}", "--plan"], "touches_store": false},
        {"id": "profile-diff", "class": "read", "bin": "ik", "argv": ["profile", "diff", "{profile}", "{profile}", "--json"], "touches_store": false},
        {"id": "analysis-describe", "class": "read", "bin": "ik", "argv": ["analysis", "describe", "{manifest}"], "touches_store": false},
        {"id": "evidence-verify", "class": "read", "bin": "ik", "argv": ["evidence", "verify", "{evidence}", "--machine", "{machine}", "--json"], "touches_store": false},
        {"id": "report", "class": "read", "bin": "ik", "argv": ["report", "{report_input}", "--json"], "touches_store": false},
        {"id": "show", "class": "read", "bin": "ik", "argv": ["--store", "{store}", "--machine", "{machine}", "show"], "stdin": "show", "touches_store": true},
        {"id": "replay", "class": "read", "bin": "ik", "argv": ["--store", "{store}", "--machine", "{machine}", "replay"], "stdin": "replay", "touches_store": true},
        {"id": "verify", "class": "read", "bin": "ik", "argv": ["--store", "{store}", "--machine", "{machine}", "verify"], "stdin": "verify", "touches_store": true},
        {"id": "lookup-operation", "class": "read", "bin": "ik", "argv": ["--store", "{store}", "--machine", "{machine}", "lookup_operation"], "stdin": "lookup_operation", "touches_store": true},
        {"id": "graph-export", "class": "scratch", "bin": "ik", "argv": ["graph", "export", "{machine}", "--out", "{graph_out}"], "touches_store": false},
        {"id": "simulate", "class": "scratch", "bin": "ik", "argv": ["simulate", "{machine}", "--out", "{simulator_out}"], "touches_store": false},
        {"id": "scenario-run", "class": "scratch", "bin": "ik", "argv": ["scenario", "run", "{machine}", "{scenario}", "--out", "{scratch}"], "touches_store": false, "refuses_store_flag": true},
        {"id": "scenario-reproduce", "class": "scratch", "bin": "ik", "argv": ["scenario", "reproduce", "{bundle}", "--out", "{scratch_repro}"], "touches_store": false, "refuses_store_flag": true}
      ]
    },
    "authorized_repair": {
      "allowed": ["read", "scratch", "write-source", "write-store"],
      "write_store_rule": "Only an explicit human authorization for one continuation, using the current capability and the original operation id. Never substitute a fresh capability into the old logical operation. Never retry an uncertain effect."
    },
    "build": {
      "allowed": ["read", "scratch", "write-source", "write-store"],
      "note": "write-store is the delivered application's domain API, not a raw initial-facts setter. Analysis runs only in scratch."
    },
    "change": {
      "allowed": ["read", "scratch", "write-source", "write-store"],
      "note": "Do not rewrite spec hashes in stored state. Old aggregates keep their machine identity."
    }
  }
}
