{
  "scenario_version": 1,
  "machine": "../approval_revision.ik.toml",
  "aggregate": "doc-stale-approval",
  "steps": [
    {"kind": "command", "label": "edit", "name": "edit", "args": {"artifact_digest": "doc-1"}, "expect": "committed"},
    {"kind": "command", "label": "approve", "name": "approve", "args": {"revision": 1}, "expect": "committed"},
    {"kind": "command", "label": "revise", "name": "edit", "args": {"artifact_digest": "doc-2"}, "expect": "committed"},
    {"kind": "command", "label": "authorize", "name": "authorize", "expect": "refused:IK_INVARIANT_FAILED"}
  ]
}
