#!/bin/sh
# Public verification gate. Needs only a Rust toolchain, Python 3, Go and Node.
# No private tooling, credentials or acceptance infrastructure.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"
cargo test --all-targets --all-features
cargo build --bin ik
test -x "$ROOT/target/debug/ik"
python3 validation/ik06/qualify.py --check
python3 validation/ik06/qualify.py --self-test
python3 validation/sdk_mutants/qualify.py --check
python3 validation/sdk_mutants/qualify.py --self-test
# Serial by default. IK_PYTEST_JOBS=<n|auto> runs the Python tests in parallel and needs pytest-xdist
# (plugin autoload is disabled, so it is named explicitly; a missing xdist fails loudly).
if [ -n "${IK_PYTEST_JOBS:-}" ]; then
  PYTEST_JOBS="-p xdist.plugin -n $IK_PYTEST_JOBS"
else
  PYTEST_JOBS=""
fi
# shellcheck disable=SC2086
PYTEST_DISABLE_PLUGIN_AUTOLOAD=1 IK_BINARY="$ROOT/target/debug/ik" \
  python3 -m pytest -q $PYTEST_JOBS "$ROOT/python/tests"
( cd "$ROOT/go" && IK_BINARY="$ROOT/target/debug/ik" go test ./... )
( cd "$ROOT/typescript" && npm ci --omit=optional && npx tsc -p tsconfig.json && IK_BINARY="$ROOT/target/debug/ik" npm test )
IK_BINARY="$ROOT/target/debug/ik" python3 validation/sdk_mutants/qualify.py --run
SCENARIO_OUT="${TMPDIR:-/tmp}/desmo-public-verify-scenarios"
rm -rf "$SCENARIO_OUT"
python3 examples/publish-approval/scenarios.py --out "$SCENARIO_OUT" > /dev/null

INIT_SMOKE="${TMPDIR:-/tmp}/desmo-public-verify-init"
rm -rf "$INIT_SMOKE"
mkdir -p "$INIT_SMOKE"
for tpl in order job; do
  "$ROOT/target/debug/ik" init "$tpl" --lang py --out "$INIT_SMOKE/py-$tpl" > /dev/null
  python3 -m py_compile "$INIT_SMOKE/py-$tpl/${tpl}_machine.py"
  PYTHONPATH="$ROOT/python/src" IK_BINARY="$ROOT/target/debug/ik" python3 "$INIT_SMOKE/py-$tpl/demo.py" > /dev/null
  PYTHONPATH="$ROOT/python/src" IK_BINARY="$ROOT/target/debug/ik" python3 "$INIT_SMOKE/py-$tpl/demo.py" > /dev/null

  "$ROOT/target/debug/ik" init "$tpl" --lang ts --out "$INIT_SMOKE/ts-$tpl" > /dev/null
  mkdir -p "$INIT_SMOKE/ts-$tpl/node_modules/@desmo"
  ln -s "$ROOT/typescript" "$INIT_SMOKE/ts-$tpl/node_modules/@desmo/runtime"
  "$ROOT/typescript/node_modules/.bin/tsc" --noEmit --target ES2022 --module NodeNext --moduleResolution NodeNext --skipLibCheck "$INIT_SMOKE/ts-$tpl/${tpl}.machine.ts"
  IK_BINARY="$ROOT/target/debug/ik" node "$INIT_SMOKE/ts-$tpl/demo.mjs" > /dev/null
  IK_BINARY="$ROOT/target/debug/ik" node "$INIT_SMOKE/ts-$tpl/demo.mjs" > /dev/null

  "$ROOT/target/debug/ik" init "$tpl" --lang go --out "$INIT_SMOKE/go-$tpl" > /dev/null
  printf '\nreplace github.com/GauravAlbal/desmo/go => %s/go\n' "$ROOT" >> "$INIT_SMOKE/go-$tpl/go.mod"
  ( cd "$INIT_SMOKE/go-$tpl" && go vet ./... && IK_BINARY="$ROOT/target/debug/ik" go run . > /dev/null && IK_BINARY="$ROOT/target/debug/ik" go run . > /dev/null )
done
rm -rf "$INIT_SMOKE"
