#!/bin/sh
# Public verification gate. Needs only a Rust toolchain, Python 3, Go and Node.
# No private tooling, credentials or acceptance infrastructure.
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
cd "$ROOT"
cargo test --all-targets --all-features
cargo build --bin ik
test -x "$ROOT/target/debug/ik"
python3 validation/ik06/qualify.py --check
python3 validation/ik06/qualify.py --self-test
PYTEST_DISABLE_PLUGIN_AUTOLOAD=1 IK_BINARY="$ROOT/target/debug/ik" \
  python3 -m pytest -q "$ROOT/python/tests"
( cd "$ROOT/go" && IK_BINARY="$ROOT/target/debug/ik" go test ./... )
( cd "$ROOT/typescript" && npm ci --omit=optional && npx tsc -p tsconfig.json && IK_BINARY="$ROOT/target/debug/ik" npm test )
python3 examples/publish-approval/scenarios.py --out "${TMPDIR:-/tmp}/desmo-public-verify-scenarios" > /dev/null
