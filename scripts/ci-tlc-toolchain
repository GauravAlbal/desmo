#!/bin/sh
# Stage the pinned TLC toolchain for this host and print the environment to export.
#
#   sh scripts/ci-tlc-toolchain >> "$GITHUB_ENV"      # CI
#   export $(sh scripts/ci-tlc-toolchain)             # local shell
#
# adapters/tlc/toolchain.json pins a macOS Homebrew Java path, so tests/tlc_adapter.rs fails on any
# other machine unless IK_TLC_TOOLCHAIN names a toolchain file for that machine. This writes one
# with the Java on PATH (or $IK_JAVA) and the pinned jar, downloading the jar when it is absent and
# refusing it unless its SHA-256 matches the pin. It installs no Java.
set -eu

JAR_SHA256=936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88
VERSION="TLC2 Version 2.19 of 08 August 2024 (rev: 5a47802)"
URL=https://github.com/tlaplus/tlaplus/releases/download/v1.7.4/tla2tools.jar

DIR="${IK_TOOLCHAIN_DIR:-$HOME/.ik-toolchain}"
JAR="$DIR/tla2tools-1.7.4.jar"
JAVA="${IK_JAVA:-$(command -v java || true)}"
if [ -z "$JAVA" ]; then
  echo "ci-tlc-toolchain: no java on PATH and IK_JAVA is unset" >&2
  exit 1
fi

mkdir -p "$DIR"
if [ ! -f "$JAR" ]; then
  curl -sSfL -o "$JAR" "$URL"
fi
if command -v sha256sum >/dev/null 2>&1; then
  actual=$(sha256sum "$JAR" | cut -d' ' -f1)
else
  actual=$(shasum -a 256 "$JAR" | cut -d' ' -f1)
fi
if [ "$actual" != "$JAR_SHA256" ]; then
  echo "ci-tlc-toolchain: $JAR has sha256 $actual, expected $JAR_SHA256" >&2
  exit 1
fi

printf '{\n  "java": "%s",\n  "jar": "%s",\n  "jar_sha256": "%s",\n  "version": "%s"\n}\n' \
  "$JAVA" "$JAR" "$JAR_SHA256" "$VERSION" > "$DIR/toolchain.json"
echo "IK_TLC_TOOLCHAIN=$DIR/toolchain.json"
echo "IK_TLC_JAR=$JAR"
